# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control — it is listed in .gitignore.

# Supabase — get these from your project's API settings (supabase.com)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Resend (optional — kept for reference; email now routes through Brevo SMTP)
VITE_RESEND_API_KEY=your_resend_api_key

# Brevo SMTP — used by the /api/send-email Vercel serverless function
# Sign up at brevo.com → SMTP & API → SMTP settings
BREVO_SMTP_LOGIN=your_brevo_smtp_login
BREVO_SMTP_PASSWORD=your_brevo_smtp_password
